# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- GitHub App (services/github/appAuth.ts) ---
GITHUB_APP_ID=123456
# Provide the PEM key via one of the following:
#   1) Inline PEM with escaped newlines
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
#   2) Path to the PEM file (relative to the working directory)
GITHUB_PRIVATE_KEY_PATH=./certs/github-app.private-key.pem
# Webhook secret configured on the GitHub App (X-Hub-Signature-256 validation)
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret

# --- Copilot Extension (middleware/copilotAuth.ts) ---
# Bearer token (JWT) verification for incoming Copilot chat requests
# COPILOT_TOKEN_ISSUER=       # optional: only enforce when the exact issuer is known
# COPILOT_TOKEN_AUDIENCE=     # optional
COPILOT_JWKS_URL=https://api.github.com/_private/jwks

# --- RAG / Vector store ---
VECTOR_STORE=memory
CHROMA_URL=http://localhost:8000
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- Phase 5: Copilot LLM + RAG pipeline ---
COPILOT_LLM_BASE_URL=https://api.githubcopilot.com
COPILOT_MODEL=gpt-4o
REPO_NAME=your-repo
RAG_TOP_K=6
MERMAID_REPAIR=true
# "copilot" (default) or "mock" for offline demo answers (no credentials needed)
LLM_PROVIDER=copilot
# Development-only auth bypass — ignored when NODE_ENV=production
COPILOT_AUTH_SKIP=false

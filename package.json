{
  "name": "repocompass",
  "version": "0.1.0",
  "description": "GitHub Copilot Agent Extension that maps repository architecture and generates onboarding documentation and Mermaid diagrams.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:embed": "vitest run test/rag/embedder.test.ts",
    "smee": "smee --url https://smee.io/KFuQ3lybP5N1CnF --target http://localhost:3000",
    "redeliver": "node scripts/redeliver.mjs",
    "index": "tsx --env-file-if-exists=.env scripts/index-repo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "hnswlib-node@3.0.0": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true
  }
}
